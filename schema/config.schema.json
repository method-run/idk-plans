{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "idk-plans configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "include": { "type": "array", "items": { "type": "string" } },
    "exclude": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "boolean" },
    "proseWrap": { "enum": ["never", "preserve"] },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "sourceUrl": { "type": "string" },
        "mermaid": { "enum": ["cdn", "local"] },
        "theme": { "type": "string", "minLength": 1, "description": "The path of an idk-themetron theme, from the project root: the \"css\" format, for token contract 0.2 (https://method-run.github.io/idk-themetron/schema/0.2.0/tokens.manifest.json). The site loads it before its own stylesheet. --theme overrides it." }
      }
    },
    "root": {
      "type": "object",
      "required": ["file", "id"],
      "properties": { "file": { "type": "string" }, "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" } }
    },
    "trees": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "additionalProperties": {
        "type": "object",
        "properties": { "title": { "type": "string" }, "primary": { "type": "boolean" }, "groups": { "type": "array", "items": { "type": "string" } } }
      }
    },
    "rules": {
      "type": "object",
      "propertyNames": { "not": { "enum": ["no-root", "frontmatter", "duplicate-id"] } },
      "additionalProperties": {
        "oneOf": [
          { "enum": ["warn", "info", "off"] },
          { "type": "array", "prefixItems": [{ "enum": ["warn", "info", "off"] }] }
        ]
      }
    }
  }
}
